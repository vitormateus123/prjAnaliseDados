# .env.example — NUNCA coloque valores reais aqui
# Copie este arquivo para .env e preencha localmente.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.

# ─── FRONTEND (React Native / Expo) ──────────────────────────────────────────
# URL do backend FastAPI.
# Para desenvolvimento local no Expo Go em dispositivo físico:
#   - Descubra o IP do seu computador (ipconfig no Windows)
#   - Use http://SEU_IP:8000 (ex: http://192.168.1.10:8000)
# Para emulador Android: http://10.0.2.2:8000
# Para emulador iOS: http://localhost:8000
# Para produção no Render.com: https://campo-analise-backend.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# Credenciais do projeto Supabase (Project Settings > API no painel do Supabase).
# Obrigatórias em qualquer build — sem elas o app quebra antes de mostrar o Login.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ─── BUILDS EAS (preview/production) ─────────────────────────────────────────
# O .env local NÃO é usado pelo EAS Build na nuvem. Para o APK ter essas
# variáveis embutidas, cadastre-as como EAS Environment Variables:
#   eas env:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "https://SEU-PROJETO.supabase.co" --environment production --environment preview
#   eas env:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "sua-anon-key" --environment production --environment preview
#   eas env:create --scope project --name EXPO_PUBLIC_API_URL --value "https://campo-analise-backend.onrender.com" --environment production --environment preview
# Depois disso, rode `eas build` de novo — variáveis já embutidas em um APK
# antigo não são atualizadas retroativamente.