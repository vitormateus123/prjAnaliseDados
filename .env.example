# .env.example — NUNCA coloque valores reais aqui
# Copie este arquivo para .env e preencha localmente.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.

# ─── FRONTEND (React Native / Expo) ──────────────────────────────────────────
# URL do backend FastAPI.
# Para desenvolvimento local no Expo Go em dispositivo físico:
#   - Descubra o IP do seu computador (ipconfig no Windows)
#   - Use http://SEU_IP:8000 (ex: http://192.168.1.10:8000)
# Para emulador Android: http://10.0.2.2:8000
# Para emulador iOS: http://localhost:8000
# Para produção no Render.com: https://campo-analise-backend.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000